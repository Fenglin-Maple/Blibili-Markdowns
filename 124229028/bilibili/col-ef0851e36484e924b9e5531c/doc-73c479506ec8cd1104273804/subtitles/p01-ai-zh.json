  "body": [
    {
      "from": 1.22,
      "to": 2.26,
      "sid": 1,
      "location": 2,
      "content": "同学们好",
      "music": 0
    },
    {
      "from": 2.26,
      "to": 4.96,
      "sid": 2,
      "location": 2,
      "content": "今天这个视频呢再给大家分享一个",
      "music": 0
    },
    {
      "from": 4.96,
      "to": 9.88,
      "sid": 3,
      "location": 2,
      "content": "最新的web coding的应用的教程",
      "music": 0
    },
    {
      "from": 10.96,
      "to": 15.27,
      "sid": 4,
      "location": 2,
      "content": "那么这个应用呢可能并没有那么容易的使用",
      "music": 0
    },
    {
      "from": 15.27,
      "to": 18.57,
      "sid": 5,
      "location": 2,
      "content": "因为它不是能简单的放在网页上的",
      "music": 0
    },
    {
      "from": 18.57,
      "to": 23.57,
      "sid": 6,
      "location": 2,
      "content": "可能需要同学们自己去GITHUB上面去拉取一下",
      "music": 0
    },
    {
      "from": 23.57,
      "to": 24.85,
      "sid": 7,
      "location": 2,
      "content": "对应的仓库",
      "music": 0
    },
    {
      "from": 24.85,
      "to": 27.97,
      "sid": 8,
      "location": 2,
      "content": "然后再做一些简单的环境的配置",
      "music": 0
    },
    {
      "from": 27.97,
      "to": 34.56,
      "sid": 9,
      "location": 2,
      "content": "当然这个过程都可以让这个AI工具来帮你完成",
      "music": 0
    },
    {
      "from": 34.86,
      "to": 36.26,
      "sid": 10,
      "location": 2,
      "content": "这个视频的目的",
      "music": 0
    },
    {
      "from": 36.26,
      "to": 39.5,
      "sid": 11,
      "location": 2,
      "content": "只是介绍一下这个工具的一个作用",
      "music": 0
    },
    {
      "from": 39.66,
      "to": 41.58,
      "sid": 12,
      "location": 2,
      "content": "好我们先看一下这个PPT",
      "music": 0
    },
    {
      "from": 41.58,
      "to": 44.94,
      "sid": 13,
      "location": 2,
      "content": "稍后我会实际演示一下",
      "music": 0
    },
    {
      "from": 45.83,
      "to": 50.79,
      "sid": 14,
      "location": 2,
      "content": "简单讲呢这个我命名为billy note AI的这个东西呢",
      "music": 0
    },
    {
      "from": 50.79,
      "to": 54.09,
      "sid": 15,
      "location": 2,
      "content": "可以把视频内容整理成学习笔记",
      "music": 0
    },
    {
      "from": 54.09,
      "to": 60.12,
      "sid": 16,
      "location": 2,
      "content": "那么实际上这个对于一般的视频总结工具来说",
      "music": 0
    },
    {
      "from": 60.12,
      "to": 62.71,
      "sid": 17,
      "location": 2,
      "content": "是一个重复造轮子的一个功能",
      "music": 0
    },
    {
      "from": 62.71,
      "to": 68.19,
      "sid": 18,
      "location": 2,
      "content": "但是它的特点就是它是运行在你的本机上的",
      "music": 0
    },
    {
      "from": 69.07,
      "to": 72.27,
      "sid": 19,
      "location": 2,
      "content": "当然主要最核心的部分就是利用了这个",
      "music": 0
    },
    {
      "from": 72.27,
      "to": 73.479,
      "sid": 20,
      "location": 2,
      "content": "whisper模型",
      "music": 0
    },
    {
      "from": 73.479,
      "to": 78.799,
      "sid": 21,
      "location": 2,
      "content": "然后这个可能对机器也有一定的硬件的要求",
      "music": 0
    },
    {
      "from": 79.539,
      "to": 82.739,
      "sid": 22,
      "location": 2,
      "content": "然后还做了一些导出的功能",
      "music": 0
    },
    {
      "from": 83.43,
      "to": 85.59,
      "sid": 23,
      "location": 2,
      "content": "我们用这个图来解释一下",
      "music": 0
    },
    {
      "from": 85.59,
      "to": 86.85,
      "sid": 24,
      "location": 2,
      "content": "更为清晰一点",
      "music": 0
    },
    {
      "from": 86.85,
      "to": 90.84,
      "sid": 25,
      "location": 2,
      "content": "如果进入启动这个应用呢",
      "music": 0
    },
    {
      "from": 90.84,
      "to": 94.38,
      "sid": 26,
      "location": 2,
      "content": "会进入一个网页的界面",
      "music": 0
    },
    {
      "from": 94.38,
      "to": 99.939,
      "sid": 27,
      "location": 2,
      "content": "那么在界面当中可以允许用户输入视频的链接",
      "music": 0
    },
    {
      "from": 99.939,
      "to": 102.759,
      "sid": 28,
      "location": 2,
      "content": "或者是使用本地文件进行上传",
      "music": 0
    },
    {
      "from": 102.759,
      "to": 108.08,
      "sid": 29,
      "location": 2,
      "content": "那么上传之后这个应用里面就设置了一些工具",
      "music": 0
    },
    {
      "from": 108.08,
      "to": 112.18,
      "sid": 30,
      "location": 2,
      "content": "将其中的音频给提取出来",
      "music": 0
    },
    {
      "from": 112.49,
      "to": 116.93,
      "sid": 31,
      "location": 2,
      "content": "提取出来就得到了一个比较小的文件嘛",
      "music": 0
    },
    {
      "from": 116.93,
      "to": 119.85,
      "sid": 32,
      "location": 2,
      "content": "然后再把这个小的文件给whisper",
      "music": 0
    },
    {
      "from": 119.85,
      "to": 124.78,
      "sid": 33,
      "location": 2,
      "content": "这个模型就可以提取出其中的文字",
      "music": 0
    },
    {
      "from": 125.18,
      "to": 127.44,
      "sid": 34,
      "location": 2,
      "content": "如果这个是一个在线视频",
      "music": 0
    },
    {
      "from": 127.44,
      "to": 128.98,
      "sid": 35,
      "location": 2,
      "content": "有软字幕的话",
      "music": 0
    },
    {
      "from": 130.46,
      "to": 133.06,
      "sid": 36,
      "location": 2,
      "content": "就是如果是YOUTUBE上面",
      "music": 0
    },
    {
      "from": 133.06,
      "to": 137.74,
      "sid": 37,
      "location": 2,
      "content": "基本上是能够支持他把这个字幕给提取出来的",
      "music": 0
    },
    {
      "from": 137.74,
      "to": 141.36,
      "sid": 38,
      "location": 2,
      "content": "然后就不依赖音频转录",
      "music": 0
    },
    {
      "from": 141.68,
      "to": 146.6,
      "sid": 39,
      "location": 2,
      "content": "进入下一步就是生成一个音频的文稿",
      "music": 0
    },
    {
      "from": 146.6,
      "to": 149.2,
      "sid": 40,
      "location": 2,
      "content": "就像字幕文件SRT一样",
      "music": 0
    },
    {
      "from": 150.14,
      "to": 154.24,
      "sid": 41,
      "location": 2,
      "content": "然后呢将这个文稿他会调用大模型",
      "music": 0
    },
    {
      "from": 154.24,
      "to": 156.9,
      "sid": 42,
      "location": 2,
      "content": "就是用户需要配置一个大模型的API",
      "music": 0
    },
    {
      "from": 156.9,
      "to": 158.73,
      "sid": 43,
      "location": 2,
      "content": "K配置好了之后呢",
      "music": 0
    },
    {
      "from": 159.77,
      "to": 161.35,
      "sid": 44,
      "location": 2,
      "content": "大模型就可以输出",
      "music": 0
    },
    {
      "from": 161.35,
      "to": 165.49,
      "sid": 45,
      "location": 2,
      "content": "关于这一个文本的一些总结的信息",
      "music": 0
    },
    {
      "from": 165.49,
      "to": 167.01,
      "sid": 46,
      "location": 2,
      "content": "包括一些摘要",
      "music": 0
    },
    {
      "from": 167.01,
      "to": 170.509,
      "sid": 47,
      "location": 2,
      "content": "或者是其中如果是个知识视频是知识点",
      "music": 0
    },
    {
      "from": 170.509,
      "to": 174.32,
      "sid": 48,
      "location": 2,
      "content": "然后还有一个思维导图是新加的一个功能",
      "music": 0
    },
    {
      "from": 174.32,
      "to": 179.12,
      "sid": 49,
      "location": 2,
      "content": "就是可以看到整个视频的这个内容",
      "music": 0
    },
    {
      "from": 179.12,
      "to": 180.28,
      "sid": 50,
      "location": 2,
      "content": "是如何展开的",
      "music": 0
    },
    {
      "from": 180.28,
      "to": 183.48,
      "sid": 51,
      "location": 2,
      "content": "关键一点是这个思维导图里面的所有节点",
      "music": 0
    },
    {
      "from": 183.48,
      "to": 185.32,
      "sid": 52,
      "location": 2,
      "content": "都可以和视频进行一个时间戳",
      "music": 0
    },
    {
      "from": 185.32,
      "to": 190.649,
      "sid": 53,
      "location": 2,
      "content": "让对应点击上面的这个呃",
      "music": 0
    },
    {
      "from": 191.409,
      "to": 194.889,
      "sid": 54,
      "location": 2,
      "content": "点击这个节点就可以跳转到对应讲这个节点的",
      "music": 0
    },
    {
      "from": 194.889,
      "to": 196.189,
      "sid": 55,
      "location": 2,
      "content": "视频的那个时间点",
      "music": 0
    },
    {
      "from": 196.189,
      "to": 198.369,
      "sid": 56,
      "location": 2,
      "content": "稍后我们演示一下",
      "music": 0
    },
    {
      "from": 199.369,
      "to": 202.649,
      "sid": 57,
      "location": 2,
      "content": "那么这个应用对我来说是比较有用的",
      "music": 0
    },
    {
      "from": 202.649,
      "to": 204.649,
      "sid": 58,
      "location": 2,
      "content": "因为我经常会在B站或者是YOUTUBE",
      "music": 0
    },
    {
      "from": 204.649,
      "to": 207.02,
      "sid": 59,
      "location": 2,
      "content": "上面看一些学习视频",
      "music": 0
    },
    {
      "from": 207.02,
      "to": 208.94,
      "sid": 60,
      "location": 2,
      "content": "有时候可能是一个软件的教程",
      "music": 0
    },
    {
      "from": 208.94,
      "to": 212.089,
      "sid": 61,
      "location": 2,
      "content": "有时候可能是一些技巧之类的",
      "music": 0
    },
    {
      "from": 212.849,
      "to": 214.809,
      "sid": 62,
      "location": 2,
      "content": "我之前有使用飞书妙计",
      "music": 0
    },
    {
      "from": 214.809,
      "to": 218.909,
      "sid": 63,
      "location": 2,
      "content": "来作为这个音频转文字的一个工具",
      "music": 0
    },
    {
      "from": 218.909,
      "to": 223.31,
      "sid": 64,
      "location": 2,
      "content": "目前的话他对它缩减了免费的一个额度",
      "music": 0
    },
    {
      "from": 223.31,
      "to": 224.95,
      "sid": 65,
      "location": 2,
      "content": "所以很快就用满了",
      "music": 0
    },
    {
      "from": 224.95,
      "to": 226.89,
      "sid": 66,
      "location": 2,
      "content": "也就基本上是不可用的一个状态",
      "music": 0
    },
    {
      "from": 226.89,
      "to": 228.56,
      "sid": 67,
      "location": 2,
      "content": "所以就只能想办法",
      "music": 0
    },
    {
      "from": 228.56,
      "to": 232.56,
      "sid": 68,
      "location": 2,
      "content": "自己用这个whisper模型去转录一下",
      "music": 0
    },
    {
      "from": 232.88,
      "to": 236.24,
      "sid": 69,
      "location": 2,
      "content": "那么基本的流程我们稍后演示一下",
      "music": 0
    },
    {
      "from": 236.24,
      "to": 237.67,
      "sid": 70,
      "location": 2,
      "content": "就更明显了",
      "music": 0
    },
    {
      "from": 237.67,
      "to": 240.99,
      "sid": 71,
      "location": 2,
      "content": "它目前支持的就是一些在线视频",
      "music": 0
    },
    {
      "from": 240.99,
      "to": 243.69,
      "sid": 72,
      "location": 2,
      "content": "主主流的网站就是YOUTUBE和哔哩哔哩",
      "music": 0
    },
    {
      "from": 243.69,
      "to": 244.97,
      "sid": 73,
      "location": 2,
      "content": "但是相对来说呢",
      "music": 0
    },
    {
      "from": 244.97,
      "to": 247.33,
      "sid": 74,
      "location": 2,
      "content": "YOUTUBE的链接会更友好一点",
      "music": 0
    },
    {
      "from": 247.33,
      "to": 250.079,
      "sid": 75,
      "location": 2,
      "content": "因为它添加过来的视频是比较清晰的",
      "music": 0
    },
    {
      "from": 250.079,
      "to": 252.899,
      "sid": 76,
      "location": 2,
      "content": "哔哩哔哩往往是最最烂的那个画质",
      "music": 0
    },
    {
      "from": 252.899,
      "to": 257.1,
      "sid": 77,
      "location": 2,
      "content": "而且嗯再点击哔哩哔哩那个视频",
      "music": 0
    },
    {
      "from": 257.1,
      "to": 257.98,
      "sid": 78,
      "location": 2,
      "content": "播放页面的时候",
      "music": 0
    },
    {
      "from": 257.98,
      "to": 259.52,
      "sid": 79,
      "location": 2,
      "content": "如果没有点击播放键",
      "music": 0
    },
    {
      "from": 259.52,
      "to": 263.26,
      "sid": 80,
      "location": 2,
      "content": "点到其他地方就会跳转哔哩哔哩本身的网站",
      "music": 0
    },
    {
      "from": 263.26,
      "to": 266.08,
      "sid": 81,
      "location": 2,
      "content": "这个就可能不是那么容易的",
      "music": 0
    },
    {
      "from": 266.08,
      "to": 269.11,
      "sid": 82,
      "location": 2,
      "content": "进行一个视频的对应",
      "music": 0
    },
    {
      "from": 269.11,
      "to": 273.53,
      "sid": 83,
      "location": 2,
      "content": "因为你需要在这个页面当中才能去点字幕",
      "music": 0
    },
    {
      "from": 273.53,
      "to": 275.87,
      "sid": 84,
      "location": 2,
      "content": "然后对应到视频这边",
      "music": 0
    },
    {
      "from": 277.74,
      "to": 281.34,
      "sid": 85,
      "location": 2,
      "content": "但是如果你光是去总结这个视频内容",
      "music": 0
    },
    {
      "from": 281.34,
      "to": 284.28,
      "sid": 86,
      "location": 2,
      "content": "或者是看这个视频的一个展开方式",
      "music": 0
    },
    {
      "from": 284.28,
      "to": 286.43,
      "sid": 87,
      "location": 2,
      "content": "也就这个思维导图的话",
      "music": 0
    },
    {
      "from": 286.43,
      "to": 289.49,
      "sid": 88,
      "location": 2,
      "content": "也完全可以使用哔哩哔哩的链接",
      "music": 0
    },
    {
      "from": 289.49,
      "to": 293.51,
      "sid": 89,
      "location": 2,
      "content": "稍后我们用哔哩哔哩的链接进行一个演示",
      "music": 0
    },
    {
      "from": 294.359,
      "to": 296.559,
      "sid": 90,
      "location": 2,
      "content": "那么上传本地视频就很好理解",
      "music": 0
    },
    {
      "from": 296.559,
      "to": 299.159,
      "sid": 91,
      "location": 2,
      "content": "就是相当于你本机上面装了一个软件",
      "music": 0
    },
    {
      "from": 299.159,
      "to": 301.679,
      "sid": 92,
      "location": 2,
      "content": "帮你来提取其中的音频",
      "music": 0
    },
    {
      "from": 301.679,
      "to": 302.519,
      "sid": 93,
      "location": 2,
      "content": "转到文字",
      "music": 0
    },
    {
      "from": 302.519,
      "to": 304.279,
      "sid": 94,
      "location": 2,
      "content": "你可以改成字幕文件",
      "music": 0
    },
    {
      "from": 304.279,
      "to": 307.56,
      "sid": 95,
      "location": 2,
      "content": "或者是如果有兴趣进行二次开发的话",
      "music": 0
    },
    {
      "from": 307.56,
      "to": 313.14,
      "sid": 96,
      "location": 2,
      "content": "就是让AI根据你的需要把这些句子分得更细",
      "music": 0
    },
    {
      "from": 313.14,
      "to": 319.5,
      "sid": 97,
      "location": 2,
      "content": "或者是说嗯各种语言的多语言的支持也都可以",
      "music": 0
    },
    {
      "from": 322.14,
      "to": 324.82,
      "sid": 98,
      "location": 2,
      "content": "刚刚我们已经讲了这个流程",
      "music": 0
    },
    {
      "from": 324.82,
      "to": 326.42,
      "sid": 99,
      "location": 2,
      "content": "这里面主要提强调一下",
      "music": 0
    },
    {
      "from": 326.42,
      "to": 328.3,
      "sid": 100,
      "location": 2,
      "content": "这个是一个字幕优先的策略",
      "music": 0
    },
    {
      "from": 328.3,
      "to": 331.78,
      "sid": 101,
      "location": 2,
      "content": "意思就是如果这个在线视频有字幕的话",
      "music": 0
    },
    {
      "from": 331.78,
      "to": 334.94,
      "sid": 102,
      "location": 2,
      "content": "包括自己也可以上传有字幕的文件",
      "music": 0
    },
    {
      "from": 334.94,
      "to": 336.24,
      "sid": 103,
      "location": 2,
      "content": "就是指的是软字幕",
      "music": 0
    },
    {
      "from": 336.24,
      "to": 338.39,
      "sid": 104,
      "location": 2,
      "content": "或者是有单独的字幕文件",
      "music": 0
    },
    {
      "from": 338.39,
      "to": 342.73,
      "sid": 105,
      "location": 2,
      "content": "那么就可以实现这样的一个对应",
      "music": 0
    },
    {
      "from": 342.73,
      "to": 344.31,
      "sid": 106,
      "location": 2,
      "content": "就相当于它是一个播放器",
      "music": 0
    },
    {
      "from": 344.31,
      "to": 345.87,
      "sid": 107,
      "location": 2,
      "content": "像pot player一样的",
      "music": 0
    },
    {
      "from": 345.87,
      "to": 351.73,
      "sid": 108,
      "location": 2,
      "content": "你可以在右侧的字幕文件点击对应的这个语句",
      "music": 0
    },
    {
      "from": 351.73,
      "to": 356.05,
